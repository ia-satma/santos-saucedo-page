# Local development / Replit Development template.
# Put real values in Replit Secrets or an ignored local .env file.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/database
CORS_ORIGIN=http://localhost:5000

# CMS bootstrap. Generate a Santos-specific hash; never reuse Von Wobeser values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ALLOW_ADMIN_INIT=false

# Keep application agents off while the CMS and database are being validated.
ENABLE_APP_AGENTS=false

# Managed AI: Replit supplies the API key + base URL pair together.
# Do not invent a key or send a Replit integration token to api.openai.com.
# Real AI activation/testing remains pending by client decision.
# Optional AI/storage integrations.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=
# Media is stored exclusively in Replit App Storage.
REPLIT_APP_STORAGE_BUCKET_ID=
PUBLIC_SITE_URL=https://santos-saucedo.replit.app
# Optional direct provider keys, only if the Replit integration does not expose that operation.
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_API_KEY=
# Set false for manual agent execution without the background queue.
AGENT_AUTO_PROCESSING=true
