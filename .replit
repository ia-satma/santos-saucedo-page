modules = ["nodejs-24", "web", "postgresql-16"]
run = "npm run start:workspace"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["unzip", "jq", "ffmpeg"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build:deploy"]
run = ["npm", "run", "start:deploy"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 24678
externalPort = 3000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start:workspace"
waitForPort = 5000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[userenv]

[userenv.shared]
ADMIN_EMAIL = "ia@satma.mx"
ENABLE_APP_AGENTS = "true"

[objectStorage]
defaultBucketID = "replit-objstore-a762ba38-4a40-4039-87df-f954bf9d578a"
